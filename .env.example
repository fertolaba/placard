# Plantilla de variables de entorno. Copiala como ".env.local" (que no se sube a Git) y completá los valores.
# Todo lo que empieza con EXPO_PUBLIC_ queda dentro de la app: es público.
# Nunca pongas acá claves secretas (por ejemplo, la "service_role key" de Supabase).

EXPO_PUBLIC_APP_ENV=development
# "supabase" = prendas y fotos en la nube, por cuenta | "sqlite" = base de datos del teléfono | "local" = datos de prueba en memoria | "api" = servidor de /server
EXPO_PUBLIC_DATA_SOURCE=supabase
# Solo se usa si DATA_SOURCE=api. En el celular real usá la IP de tu PC (ej: http://192.168.1.20:3000)
EXPO_PUBLIC_API_URL=

# Cuentas con Supabase (Project Settings → API): la URL del proyecto y la anon key (o publishable key).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Detección automática de prendas con Gemini.
EXPO_PUBLIC_GEMINI_API_KEY=
