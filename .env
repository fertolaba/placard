# Copiá este archivo como ".env" (el ".env" NO se sube a Git).
# Todo lo que empieza con EXPO_PUBLIC_ queda dentro de la app: es público.
# Nunca pongas acá claves secretas ni contraseñas.

EXPO_PUBLIC_APP_ENV=development
# "local" = datos de prueba en memoria | "api" = se conecta al servidor de /server
EXPO_PUBLIC_DATA_SOURCE=sqlite
# Solo se usa si DATA_SOURCE=api. En el celular real usá la IP de tu PC (ej: http://192.168.1.20:3000)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Detección automática de prendas con Gemini: poné la clave en ".env.local" (NO acá, este archivo se sube a Git).
# EXPO_PUBLIC_GEMINI_API_KEY=
